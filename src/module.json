{
  "id": "echojam",
  "name": "Echojam",
  "abbrev": "EJ",
  "version": "3.0.0",
  "description": "Airwindows Echojam: echo that is secretly a reverb",
  "author": "Airwindows (port: charlesvestal)",
  "license": "MIT",
  "dsp": "echojam.so",
  "api_version": 2,
  "capabilities": {
    "chainable": true,
    "component_type": "audio_fx",
    "ui_hierarchy": {
      "levels": {
        "root": {
          "name": "Echojam",
          "params": [
            {
              "key": "select",
              "label": "Select",
              "type": "int",
              "min": 0,
              "max": 16,
              "default": 8,
              "step": 1
            },
            {
              "key": "regen",
              "label": "Regen",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "default": 0.5,
              "step": 0.01,
              "unit": "%"
            },
            {
              "key": "speed",
              "label": "Speed",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "default": 0.5,
              "step": 0.01,
              "unit": "%"
            },
            {
              "key": "mix",
              "label": "Dry/Wet",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "default": 0.5,
              "step": 0.01,
              "unit": "%"
            }
          ],
          "knobs": [
            "select",
            "regen",
            "speed",
            "mix"
          ]
        }
      }
    }
  }
}
